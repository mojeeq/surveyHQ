# ============================================================================
# susoDash configuration
# Copy to .env and change every value marked CHANGE-ME before going live.
# ============================================================================

# --- General -----------------------------------------------------------------
PROJECT_NAME=susoDash
ENVIRONMENT=production
# Public URL the browser uses to reach the platform (used in emails / links)
PUBLIC_URL=http://localhost:8080

# Shared dashboards can answer on their own subdomain of this domain, e.g.
# labour-force.dash.example.org. It needs a wildcard DNS record and a wildcard
# certificate for *.dash.example.org - see docs/deployment.md. Leave it empty
# and dashboards are reached by their share link only.
DASHBOARD_DOMAIN=
LOG_LEVEL=INFO

# --- Security ----------------------------------------------------------------
# Sign-in tokens. Generate: openssl rand -hex 32
SECRET_KEY=CHANGE-ME-openssl-rand-hex-32
# Encrypts stored Survey Solutions passwords at rest.
# Generate: docker compose run --rm api python -m app.cli gen-encryption-key
ENCRYPTION_KEY=CHANGE-ME-fernet-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma separated. Use your real domain in production.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- First administrator (created on first boot only) -------------------------
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=CHANGE-ME-strong-password
FIRST_ADMIN_NAME=Administrator

# --- Database ----------------------------------------------------------------
# These name the database an installation's data already lives in, so they are
# not renamed with the brand. Change them only on a fresh install.
POSTGRES_USER=surveyhq
POSTGRES_PASSWORD=CHANGE-ME-db-password
POSTGRES_DB=surveyhq
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / task queue -------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Storage ------------------------------------------------------------------
# Where dataset parquet files and uploads live inside the containers.
STORAGE_DIR=/data
# Max upload size in megabytes
MAX_UPLOAD_MB=512

# --- Ports exposed on the host -----------------------------------------------
WEB_PORT=8080
API_PORT=8000

# --- Email notifications (optional) -------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=susoDash <no-reply@example.com>

# --- Scheduler ----------------------------------------------------------------
# How often the beat scheduler checks for due connection syncs (minutes)
SYNC_TICK_MINUTES=5
# How often indicators / alert rules / quality checks are evaluated (minutes)
MONITOR_TICK_MINUTES=15
