# ============================================================================
# susoDash configuration
# Copy to .env and change every value marked CHANGE-ME before going live.
# ============================================================================

# --- General -----------------------------------------------------------------
PROJECT_NAME=susoDash
ENVIRONMENT=production
# Public URL the browser uses to reach the platform (used in emails / links)
PUBLIC_URL=http://localhost:8080

# Shared dashboards can answer on their own subdomain of this domain, e.g.
# labour-force.dash.example.org. It needs a wildcard DNS record and a wildcard
# certificate for *.dash.example.org - see docs/deployment.md. Leave it empty
# and dashboards are reached by their share link only.
DASHBOARD_DOMAIN=
LOG_LEVEL=INFO

# --- Security ----------------------------------------------------------------
# Sign-in tokens. Generate: openssl rand -hex 32
SECRET_KEY=CHANGE-ME-openssl-rand-hex-32
# Encrypts stored Survey Solutions passwords at rest.
# Generate: docker compose run --rm api python -m app.cli gen-encryption-key
ENCRYPTION_KEY=CHANGE-ME-fernet-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma separated. Use your real domain in production.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Caps sign-in attempts and requests to shared dashboards. Leave it on unless
# every visitor reaches you from one address - some corporate proxies do that,
# and they would share one budget between them.
RATE_LIMIT_ENABLED=true

# --- First administrator (created on first boot only) -------------------------
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=CHANGE-ME-strong-password
FIRST_ADMIN_NAME=Administrator

# --- Database ----------------------------------------------------------------
# These name the database an installation's data already lives in, so they are
# not renamed with the brand. Change them only on a fresh install.
POSTGRES_USER=surveyhq
POSTGRES_PASSWORD=CHANGE-ME-db-password
POSTGRES_DB=surveyhq
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / task queue -------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Heavy imports and latency-sensitive monitoring run in separate worker pools.
# Raise these only when the host has enough CPU/RAM and fast storage.
IMPORT_WORKER_CONCURRENCY=2
MONITOR_WORKER_CONCURRENCY=2

# --- Storage ------------------------------------------------------------------
# Where dataset parquet files and uploads live inside the containers. For large
# census/HIES workloads put the Docker volume backing /data on SSD/NVMe storage.
STORAGE_DIR=/data
# Max upload size in megabytes. This also bounds how far a zip may expand once
# it is opened: the files inside one may come to twenty times this, which is
# generous for real exports and finite for an archive built to exhaust memory.
MAX_UPLOAD_MB=512

# --- Columnar analytics performance ------------------------------------------
# 0 chooses a conservative value from the host's CPU count. On a dedicated
# analytical server you can set an explicit per-query thread count instead.
DUCKDB_THREADS=0
# Per DuckDB connection. Keep enough RAM for Postgres, the API and Celery.
DUCKDB_MEMORY_LIMIT=2GB
# Temporary spill files for joins/sorts. This should be on fast SSD/NVMe.
DUCKDB_TEMP_DIR=/data/duckdb_tmp
# CSV/TAB/TXT files at or above this size bypass pandas and are streamed through
# DuckDB's parallel delimited-file reader directly into Parquet.
DUCKDB_CSV_ABOVE_MB=32
# Aggregate chart/query results are cached in Redis. The dataset version is in
# every cache key, so a refresh automatically moves queries to fresh entries.
ANALYTICS_CACHE_ENABLED=true
ANALYTICS_CACHE_TTL_SECONDS=300
# Build a compact monitoring summary after each import so the default fieldwork
# page does not repeatedly scan the full respondent/interview file.
MONITORING_PRECOMPUTE_ENABLED=true

# --- Ports exposed on the host -----------------------------------------------
# Plain HTTP is local-only by default so it can sit safely behind Caddy/nginx
# HTTPS. Set 0.0.0.0 only when direct LAN exposure is deliberate.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
API_PORT=8000

# --- Email notifications (optional) -------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=susoDash <no-reply@example.com>

# --- Running R over a project -------------------------------------------------
# R is off by default. When enabled in Docker, SurveyHQ invokes a dedicated
# unprivileged sandbox launcher. Linux Landlock limits filesystem access to the
# current project's workspace and read-only runtime files; seccomp blocks
# networking and kernel/process escape syscalls. Timeout and memory limits are
# additional safeguards.
R_SCRIPTS_ENABLED=false
# Do not point this at raw /usr/bin/Rscript. The Docker image builds this
# launcher and the application deliberately defaults to it so R fails closed
# when the sandbox is unavailable.
R_BINARY=surveyhq-r-sandbox
# A script still running after this many seconds is stopped, and nothing it did
# is saved.
R_TIMEOUT_SECONDS=60
# The most memory one script may ask for, in megabytes.
R_MEMORY_MB=2048

# --- Scheduler ----------------------------------------------------------------
# How often the beat scheduler checks for due connection syncs (minutes)
SYNC_TICK_MINUTES=5
# How often indicators / alert rules / quality checks are evaluated (minutes)
MONITOR_TICK_MINUTES=15
